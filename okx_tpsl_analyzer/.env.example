# OKX API credentials — READ-ONLY key strongly recommended (no trade / no withdraw permission).
# Create at: OKX -> Profile -> API -> Create V5 API Key -> permission: "Read"
OKX_API_KEY=your_api_key_here
OKX_API_SECRET=your_secret_key_here
OKX_API_PASSPHRASE=your_passphrase_here

# Set to 1 to hit the OKX demo/paper-trading environment instead of live.
OKX_SIMULATED=0

# Optional: override base REST host (e.g. an unblocked mirror such as https://my.okx.com)
OKX_BASE_URL=https://www.okx.com

# ---- Analysis parameters (all optional, sane defaults in config.py) ----
# Candle granularity used for excursion detection
CANDLE_BAR=1m

# Extension window (post TP/SL observation) rules
EXT_MIN_HOURS=4
EXT_MAX_HOURS=72
# Stop extending once price retraces this many ATR from the running peak
EXT_RETRACE_ATR_MULT=1.5
# Fallback retracement threshold (fraction, 0.015 = 1.5%) when ATR is unavailable
EXT_RETRACE_PCT_FALLBACK=0.015
# 'close' = retracement judged on candle close (stable, ignores single wicks)
# 'extreme' = judged on intrabar low/high (reacts faster, wick-sensitive)
EXT_RETRACE_BASIS=close

# ATR settings (computed on 1H bars resampled from the cached candles)
ATR_PERIOD=14

# TP/SL close classification tolerance, in instrument ticks
CLOSE_MATCH_TICK_TOLERANCE=8
# ...and as a fraction of price, whichever is larger
CLOSE_MATCH_PCT_TOLERANCE=0.0015

# Local cache directory for OHLCV parquet files
CACHE_DIR=./cache
OUTPUT_DIR=./output
